# ==============================================================================
# ORACLE ARM HUNTER CONFIGURATION (.env)
# ==============================================================================
# Skopiuj ten plik do: scripts/oracle-hunter.env
# Skrypt oracle-arm-hunter.sh automatycznie odczyta te wartości lub spróbuje
# je wykryć samoczynnie za pomocą flagi: ./oracle-arm-hunter.sh --discover
# ==============================================================================

# Nazwa instancji w konsoli Oracle Cloud
DISPLAY_NAME="vps-oracle-arm-prod"

# Identyfikatory zasobów (OCID)
# Jeśli pozostawisz puste, skrypt wykryje je automatycznie na podstawie ~/.oci/config
COMPARTMENT_OCID=""
AVAILABILITY_DOMAIN=""
SUBNET_OCID=""
IMAGE_OCID=""

# Zasoby maszyny Always Free ARM Ampere A1 (Max: 4 OCPU, 24 GB RAM, 200 GB dysk)
OCPUS=4
MEMORY_IN_GBS=24
BOOT_VOLUME_SIZE_IN_GBS=100

# Ścieżka do Twojego publicznego klucza SSH
# Na WSL2 domyślnie montuje klucz z Windowsa: /mnt/c/Users/pocza/.ssh/id_ed25519.pub
SSH_AUTHORIZED_KEY_PATH="/mnt/c/Users/pocza/.ssh/id_ed25519.pub"

# Powiadomienia Push na telefon (aplikacja Ntfy)
NTFY_TOPIC="kpoczatek-vps-alerty"

# Interwał odpytywania API w sekundach (bezpieczna wartość: 60s + losowy jitter)
POLL_INTERVAL_SECONDS=60
