# ==============================================================================
# DEVOPS STACK - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# BEZPIECZEŃSTWO:
# 1. Skopiuj ten plik do '.env': cp .env.example .env
# 2. NIGDY nie commituj pliku '.env' do repozytorium Git (znajduje się w .gitignore).
# 3. Zmień wszystkie domyślne hasła i tokeny na silne, losowo wygenerowane ciągi znaków (min. 32 znaki).
# ==============================================================================

# --- GRAFANA CONFIGURATION ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe_GrafanaSuperSecurePassword_2026!

# --- UPTIME KUMA & NTFY CONFIGURATION ---
KUMA_ADMIN_USER=admin
KUMA_ADMIN_PASS=ChangeMe_KumaSuperSecurePassword_2026!
NTFY_TOPIC=twojastronawww-alerty-prod

# --- CLOUDFLARE TUNNEL (EXTENSIONS) ---
# Token uzyskany z Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=eyJh...example_token...

# --- DOMAINS / HOSTNAMES ---
MONITORING_DOMAIN=monitoring.example.com
STATUS_DOMAIN=status.example.com

# --- GITHUB ACTIONS RUNNERS & TELEMETRY ---
# Token GitHuba do telemetrii repozytoriów i workflow (np. gho_... lub ghp_...)
GITHUB_TOKEN=ghp_exampleTokenForTelemetry123
# Opcja A (Zalecana - Zunifikowane runnery organizacji):
# Token z: https://github.com/organizations/zeslownikiem/settings/actions/runners/new
RUNNER_ORG_TOKEN=
# Token z: https://github.com/organizations/TwojaStronaWWW/settings/actions/runners/new
RUNNER_TWOJASTRONAWWW_ORG_TOKEN=

# Opcja B (Osobne runnery per repozytorium):
RUNNER_DESKTOP_TOKEN=
RUNNER_WEB_TOKEN=

# --- OFFSITE BACKUP (S3 / Cloudflare R2 / Oracle Object Storage) ---
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=devops-vps-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- LH.PL HOSTING WEBSITES BACKUP ---
# Dane dostępowe do hostingu LH.pl (zgodne z GitHub Secrets w repozytoriach TwojaStronaWWW):
LH_FTP_SERVER=ftp.lh.pl
LH_FTP_PORT=21
LH_FTP_USERNAME=
LH_FTP_PASSWORD=
LH_REMOTE_DIR=/public_html
LH_BACKUP_DIR=/opt/devops-stack/backups/websites

# --- AI ROUTER CONFIGURATION (GEMINI PROXY & RAG) ---
# Klucz API uzyskany z Google AI Studio: https://aistudio.google.com/
# Przed wdrożeniem zarejestruj ten klucz w KeePass: Databasekpoczatek.kdbx -> "VPS - TwojaStronaWWW"
GEMINI_API_KEY=AIzaSy...exampleGeminiApiKey12345
GEMINI_MODEL=gemini-3.8-flash
# Opcjonalne darmowe klucze zapasowe (Multi-Provider Fallback - Llama 3.3 70B Free Tier):
GROQ_API_KEY=
# Model Groq (llama-3.3-70b-versatile nie jest juz dostepny na koncie; lista: GET https://api.groq.com/openai/v1/models)
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# Opcjonalne limity dzienne (RPD) per model - wpisz wartości widoczne w Google AI Studio -> Rate limits.
# Format: model=limit,model=limit. Pusta wartość = brak paska zużycia i alertu >80% w Grafanie.
MODEL_DAILY_LIMITS=
ALLOWED_ORIGINS=https://katosalsahub.pl,https://www.katosalsahub.pl,https://fuegolingua.pl,https://www.fuegolingua.pl,https://twojastronawww.pl,https://www.twojastronawww.pl

# --- TIMEZONE ---
TZ=Europe/Warsaw


