# ==============================================================================
# DEVOPS STACK - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# BEZPIECZEŃSTWO:
# 1. Skopiuj ten plik do '.env': cp .env.example .env
# 2. NIGDY nie commituj pliku '.env' do repozytorium Git (znajduje się w .gitignore).
# 3. Zmień wszystkie domyślne hasła i tokeny na silne, losowo wygenerowane ciągi znaków (min. 32 znaki).
# ==============================================================================

# --- GRAFANA CONFIGURATION ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe_GrafanaSuperSecurePassword_2026!
# Domyślna rola dostępu przez tunel lokalny (PoLP ISO 27001): Viewer (tylko odczyt)
# GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer

# --- UPTIME KUMA & NTFY CONFIGURATION ---
KUMA_ADMIN_USER=admin
KUMA_ADMIN_PASS=ChangeMe_KumaSuperSecurePassword_2026!
NTFY_TOPIC=twojastronawww-alerty-prod

# --- CLOUDFLARE TUNNEL (EXTENSIONS) ---
# Token uzyskany z Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=eyJh...example_token...

# --- DOMAINS / HOSTNAMES ---
MONITORING_DOMAIN=monitoring.example.com
STATUS_DOMAIN=status.example.com

# --- GITHUB ACTIONS RUNNERS & TELEMETRY ---
# Token GitHuba do telemetrii repozytoriów i workflow (np. gho_... lub ghp_...)
GITHUB_TOKEN=ghp_exampleTokenForTelemetry123
# Opcja A (Zalecana - Zunifikowane runnery organizacji w odseparowanej sieci devops_runners_network):
# Token z: https://github.com/organizations/zeslownikiem/settings/actions/runners/new
RUNNER_ORG_TOKEN=
# Token z: https://github.com/organizations/TwojaStronaWWW/settings/actions/runners/new
RUNNER_TWOJASTRONAWWW_ORG_TOKEN=

# Opcja B (Osobne runnery per repozytorium):
RUNNER_DESKTOP_TOKEN=
RUNNER_WEB_TOKEN=

# --- OFFSITE BACKUP (S3 / Cloudflare R2 / Oracle Object Storage) ---
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=devops-vps-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Klucz szyfrowania symetrycznego AES-256-CBC (PBKDF2) przed wysyłką do chmury R2 (min. 32 znaki):
BACKUP_ENCRYPTION_KEY=ChangeMe_BackupAes256EncryptionKey_2026!
# Okres retencji kopii zapasowych w dniach (lokalnie na VPS oraz w chmurze Cloudflare R2, domyślnie 30 dni):
# RETENTION_DAYS=30

# --- LH.PL HOSTING WEBSITES BACKUP (FTPS TLS + MYSQL DUMP) ---
# Dane dostępowe do hostingu LH.pl (zgodne z GitHub Secrets w repozytoriach TwojaStronaWWW):
LH_FTP_SERVER=ftp.lh.pl
LH_FTP_PORT=21
LH_FTP_USERNAME=
LH_FTP_PASSWORD=
LH_REMOTE_DIR=/public_html
LH_BACKUP_DIR=/opt/devops-stack/backups/websites
# Opcjonalne wymuszenie FTPS TLS (domyślnie true) oraz zrzut baz MySQL (np. osTicket Helpdesk, WordPress):
# LH_FTP_SSL=true
# LH_DB_HOST=
# LH_DB_NAME=
# LH_DB_NAMES=db1,db2
# LH_DB_USER=
# LH_DB_PASSWORD=

# --- AI ROUTER CONFIGURATION (MULTI-PROVIDER RAG PROXY + CACHE <5ms + LEAD DETECTOR) ---
# Wszystkie 6 kluczy API musi być zarejestrowanych w KeePass: Databasekpoczatek.kdbx -> "VPS - TwojaStronaWWW"
# 1. Klucz główny Google AI Studio (obsługuje 5 modeli: gemini-3.5-flash [thinkingLevel:MINIMAL], gemini-3.5-flash-lite, 3.7-flash, 3.8-flash, gemma-4-31b-it):
GEMINI_API_KEY=AIzaSy...exampleGeminiApiKey12345
GEMINI_MODEL=gemini-3.5-flash
# 2. Pierwszy zewnętrzny fallback LPU (~0.6s, Fast-Fail po timeoucie 4s lub 2 modelach na cooldownie - https://console.groq.com/keys):
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# 3. Drugi zewnętrzny fallback Wafer-Scale Engine (~0.15s, 2 modele: gpt-oss-120b [2400 RPD] + qwen-3.8-27b [648000 RPD] - https://cloud.cerebras.ai/):
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# 3b. Dedykowany Silnik SQL/Oracle WYŁĄCZNIE dla wewnętrznego Asystenta AMMS (Mistral AI Codestral - https://console.mistral.ai/api-keys, $0.00 Free Tier):
MISTRAL_API_KEY=
MISTRAL_SQL_MODEL=codestral-latest
# 4. Trzeci zewnętrzny fallback Cloudflare Workers AI (10 000 Neurons/day Free Tier - https://dash.cloudflare.com/profile/api-tokens):
CF_AI_API_TOKEN=
CF_ACCOUNT_ID=
CF_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# 5. Czwarty zewnętrzny fallback (OpenRouter API - https://openrouter.ai/keys, WYŁĄCZNIE modele ':free' z reasoning effort:none):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# 6. Ostatni bezpiecznik (Pozycja 10 w kaskadzie - Anthropic Claude Haiku 4.5, Pre-paid $5, Extended Thinking: disabled, Prompt Caching: ephemeral -90%):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Opcjonalne nadpisanie domyślnych limitów dziennych (RPD) per model (domyślne Free Tier: 1500/500/14400/1000/2400/648000/1000/200/1000):
MODEL_DAILY_LIMITS=
# Czas życia pamięci podręcznej odpowiedzi RAG w sekundach (domyślnie 86400s = 24h):
# AI_CACHE_TTL=86400
# Opcjonalny dodatkowy webhook JSON dla przechwyconych leadów kontaktowych (np. osTicket / CRM / Discord / Make):
# LEAD_WEBHOOK_URL=
ALLOWED_ORIGINS=https://katosalsahub.pl,https://www.katosalsahub.pl,https://dancepuls.pl,https://www.dancepuls.pl,https://fuegolingua.pl,https://www.fuegolingua.pl,https://twojastronawww.pl,https://www.twojastronawww.pl,https://raricart.pl,https://www.raricart.pl

# --- GOOGLE SEARCH CONSOLE API (ORGANIC KEYWORDS TELEMETRY, 0 KB JS NA STRONIE) ---
# Opcjonalny klucz Service Account (JSON w Base64 lub ścieżka do pliku .json, tylko uprawnienia Odczytu w GSC):
# GSC_SERVICE_ACCOUNT_JSON=
# Mapowanie site_id na usługi w Google Search Console (np. katosalsahub:katosalsahub.pl):
# GSC_SITES=katosalsahub:katosalsahub.pl,dancepuls:dancepuls.katosalsahub.pl,fuegolingua:fuegolingua.pl,twojastronawww:twojastronawww.pl,raricart:raricart.pl

# --- TIMEZONE ---
TZ=Europe/Warsaw
