# ==============================================================================
# Supply Chain Security Hardening (ISO 27001 / 7-Day Release Buffer & No-Scripts)
# Blokuje automatyczne uruchamianie skryptów postinstall (ochrona przed malware)
# oraz wymusza 7-dniowy bufor wieku dla nowych wydań paczek.
# ==============================================================================
ignore-scripts=true
audit=true
fund=false
min-release-age=7
