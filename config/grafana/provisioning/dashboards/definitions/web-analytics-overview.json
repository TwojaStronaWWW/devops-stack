    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Unikalni odwiedzający w wybranym okresie (w trybie Automatycznym: do 09:00 rano dane z Wczoraj, po 09:00 dane z Dziś; anonimowy dzienny skrót SHA-256 w strefie Europe/Warsaw, bez zapisu IP i bez ciasteczek; metryki: web_analytics_period_unique_visitors, web_analytics_unique_visitors_today, web_analytics_unique_visitors_total).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 301,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum by (effective_label) (web_analytics_period_unique_visitors{site=~\"$site\",site!~\"twojastronawww|radar-p1|katosalsahub|dancepuls|fuegolingua\",period=\"$period\"}) or on() vector(0)",
          "instant": true,
          "legendFormat": "{{effective_label}}",
          "refId": "A"
        }
      ],
      "title": "Unikalni Odwiedzający",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
