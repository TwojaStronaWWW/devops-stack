{
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Monitoring mikro-routera AI: dostepnosc, kaskada modeli, przelaczenia, limity, zawieszenia i zasoby - TwojaStronaWWW DevOps Stack",
  "editable": false,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": ["twojastronawww"],
      "targetBlank": false,
      "title": "Dashboardy TwojaStronaWWW",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "AI Router - Status i Dostepnosc",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "index": 1, "text": "DOWN" }, "1": { "color": "green", "index": 0, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "10.4.1",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "up{job=\"ai-router\"}", "instant": true, "legendFormat": "AI Router", "refId": "A" } ],
      "title": "Status AI Router",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 } ] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "10.4.1",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "scrape_duration_seconds{job=\"ai-router\"}", "instant": true, "legendFormat": "Czas /health", "refId": "A" } ],
      "title": "Czas odpowiedzi /health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "gradientMode": "opacity", "lineWidth": 2, "showPoints": "never", "spanNulls": false },
          "unit": "short", "max": 1, "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 1 },
      "id": 4,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "up{job=\"ai-router\"}", "legendFormat": "AI Router - dostepnosc (1=UP 0=DOWN)", "refId": "A" } ],
      "title": "Historia dostepnosci AI Routera",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 11,
      "title": "Zasoby kontenera ai-router (Czatboty WWW + Asystent Ekspercki AMMS & Oracle DBA)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "gradientMode": "opacity", "lineWidth": 2, "showPoints": "never", "spanNulls": false },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(container_cpu_usage_seconds_total{name=\"ai-router\"}[5m])", "legendFormat": "CPU ai-router (Czatboty WWW + AMMS)", "refId": "A" } ],
      "title": "CPU - kontener ai-router (Czatboty WWW + AMMS)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "gradientMode": "opacity", "lineWidth": 2, "showPoints": "never", "spanNulls": false },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "container_memory_working_set_bytes{name=\"ai-router\"}", "legendFormat": "RAM ai-router (Czatboty WWW + AMMS)", "refId": "A" } ],
      "title": "RAM - kontener ai-router (Czatboty WWW + AMMS)",
      "type": "timeseries"
    },
    {"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":18},"id":100,"title":"Kaskada modeli i Cache RAG - kontrola przełączania, limitów i zawieszeń","type":"row"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Liczba udanych odpowiedzi czatu w ostatnich 24h (wszystkie strony)","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"unit":"short","decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]}},"overrides":[]},"gridPos":{"h":4,"w":3,"x":0,"y":19},"id":101,"options":{"colorMode":"value","graphMode":"none","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"round(sum(increase(ai_router_requests_total{outcome=\"success\"}[24h]))) or sum(ai_router_requests_total{outcome=\"success\"})","legendFormat":"Udane odpowiedzi (24h)","refId":"A","instant":true}],"title":"Udane odpowiedzi (24h)","type":"stat"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Udział odpowiedzi udzielonych przez model inny niż pierwszy w kaskadzie (#1 Gemini 3.5 Flash). 0% = pierwszy asystent obsłużył wszystko.","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"unit":"percentunit","decimals":1,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":0.3},{"color":"red","value":0.8}]}},"overrides":[]},"gridPos":{"h":4,"w":3,"x":3,"y":19},"id":102,"options":{"colorMode":"value","graphMode":"none","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(ai_router_answers_by_depth_total{depth!=\"0\",source!=\"\"}) / clamp_min(sum(ai_router_answers_by_depth_total{source!=\"\"}), 1)","legendFormat":"Odpowiedzi z modeli zapasowych","refId":"A","instant":true}],"title":"Modele zapasowe","type":"stat"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Zapytania, na które nie odpowiedział żaden model (HTTP 502)","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"unit":"short","decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}},"overrides":[]},"gridPos":{"h":4,"w":3,"x":6,"y":19},"id":103,"options":{"colorMode":"value","graphMode":"none","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"round(sum(increase(ai_router_requests_total{outcome=\"all_models_failed\"}[24h]))) or vector(0)","legendFormat":"Błędy - wszystkie modele padły (24h)","refId":"A","instant":true}],"title":"Błędy 502 (24h)","type":"stat"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Modele w cooldownie po 429/5xx/404 - router je pomija","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"unit":"short","decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":3}]}},"overrides":[]},"gridPos":{"h":4,"w":3,"x":9,"y":19},"id":104,"options":{"colorMode":"value","graphMode":"none","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(ai_router_model_suspended)","legendFormat":"Zawieszone modele teraz","refId":"A","instant":true}],"title":"Zawieszone modele","type":"stat"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Skonfigurowane klucze: Gemini, Groq, Cerebras, Mistral (AMMS SQL), Cloudflare, OpenRouter, Anthropic (max 7). 1 = brak zapasowego providera.","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"unit":"short","decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"yellow","value":1},{"color":"green","value":2}]}},"overrides":[]},"gridPos":{"h":4,"w":3,"x":12,"y":19},"id":105,"options":{"colorMode":"value","graphMode":"none","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(ai_router_provider_configured)","legendFormat":"Aktywni providerzy","refId":"A","instant":true}],"title":"Aktywni providerzy","type":"stat"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Średni czas odpowiedzi czatu w ostatniej godzinie","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"unit":"s","decimals":2,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":5},{"color":"red","value":12}]}},"overrides":[]},"gridPos":{"h":4,"w":3,"x":15,"y":19},"id":106,"options":{"colorMode":"value","graphMode":"none","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"increase(ai_router_request_duration_seconds_sum[1h]) / clamp_min(increase(ai_router_request_duration_seconds_count[1h]), 1)","legendFormat":"Śr. czas odpowiedzi czatu (1h)","refId":"A","instant":true}],"title":"Śr. czas odpowiedzi (1h)","type":"stat"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Liczba błyskawicznych odpowiedzi z pamięci podręcznej RAG (<5 ms, 0 zużytych tokenów API)","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"unit":"short","decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"blue","value":null},{"color":"green","value":1}]}},"overrides":[]},"gridPos":{"h":4,"w":3,"x":18,"y":19},"id":118,"options":{"colorMode":"value","graphMode":"none","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(ai_router_cache_hits_total) or on() vector(0)","legendFormat":"Trafienia Cache RAG","refId":"A","instant":true}],"title":"Trafienia Cache RAG (<5ms)","type":"stat"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Liczba aktywnych odpowiedzi zapamiętanych w pamięci podręcznej RAG (/app/storage/cache)","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"unit":"short","decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"blue","value":null},{"color":"green","value":1}]}},"overrides":[]},"gridPos":{"h":4,"w":3,"x":21,"y":19},"id":119,"options":{"colorMode":"value","graphMode":"none","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"ai_router_cache_entries or on() vector(0)","legendFormat":"Wpisy w Cache RAG","refId":"A","instant":true}],"title":"Wpisy w Cache RAG","type":"stat"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Stan każdego modelu kaskady. Doba kwotowa Gemini kończy się o północy czasu Pacyficznego (09:00 w Polsce).","fieldConfig":{"defaults":{"custom":{"align":"auto"}},"overrides":[{"matcher":{"id":"byName","options":"Zawieszony"},"properties":[{"id":"mappings","value":[{"type":"value","options":{"0":{"text":"aktywny","color":"green","index":0},"1":{"text":"ZAWIESZONY","color":"red","index":1}}}]},{"id":"custom.cellOptions","value":{"type":"color-text"}}]},{"matcher":{"id":"byName","options":"Ostatni sukces"},"properties":[{"id":"unit","value":"dateTimeFromNow"},{"id":"mappings","value":[{"type":"value","options":{"0":{"text":"brak","index":0}}}]}]},{"matcher":{"id":"byName","options":"Ostatni błąd"},"properties":[{"id":"unit","value":"dateTimeFromNow"},{"id":"mappings","value":[{"type":"value","options":{"0":{"text":"brak","index":0}}}]}]}]},"gridPos":{"h":9,"w":24,"x":0,"y":23},"id":107,"options":{"showHeader":true,"cellHeight":"sm"},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (model, provider) (ai_router_model_suspended)","format":"table","instant":true,"refId":"A"},{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (model, provider) (ai_router_model_cooldown_remaining_seconds)","format":"table","instant":true,"refId":"B"},{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (model, provider) (ai_router_model_requests_today)","format":"table","instant":true,"refId":"C"},{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (model, provider) (ai_router_model_ok_today)","format":"table","instant":true,"refId":"D"},{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (model, provider) (ai_router_model_daily_limit)","format":"table","instant":true,"refId":"E"},{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (model, provider) (ai_router_model_last_success_timestamp_seconds) * 1000","format":"table","instant":true,"refId":"F"},{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (model, provider) (ai_router_model_last_error_timestamp_seconds) * 1000","format":"table","instant":true,"refId":"G"},{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (model, provider) (ai_router_model_skipped_total)","format":"table","instant":true,"refId":"H"}],"transformations":[{"id":"merge","options":{}},{"id":"organize","options":{"excludeByName":{"Time":true},"renameByName":{"Value #A":"Zawieszony","Value #B":"Cooldown [s]","Value #C":"Zapytania dziś","Value #D":"OK dziś","Value #E":"Limit dzienny","Value #F":"Ostatni sukces","Value #G":"Ostatni błąd","Value #H":"Pominięć (cooldown)","model":"Model","provider":"Provider"}}}],"title":"Stan kaskady modeli (asystentów)","type":"table"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Liczba udanych odpowiedzi (modele AI + pamięć podręczna Cache RAG).","fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"drawStyle":"bars","fillOpacity":60,"gradientMode":"opacity","lineWidth":2,"showPoints":"never","spanNulls":false,"stacking":{"mode":"normal","group":"A"}},"unit":"short","decimals":0,"min":0},"overrides":[]},"gridPos":{"h":8,"w":12,"x":0,"y":32},"id":108,"interval":"1m","options":{"legend":{"calcs":["sum","lastNotNull"],"displayMode":"table","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (model) (round(increase(ai_router_model_attempts_total{result=\"ok\"}[2m])))","interval":"1m","legendFormat":"{{model}}","refId":"A"},{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (site) (round(increase(ai_router_cache_hits_total[2m])))","interval":"1m","legendFormat":"Cache RAG (<5ms) - {{site}}","refId":"B"}],"title":"Odpowiedzi wg modelu i Cache RAG (kto odpowiada)","type":"timeseries"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"rate_limited/quota_daily = 429, unavailable = 5xx, not_found = 404, auth = zły klucz, network = timeout/cURL, empty = pusta odpowiedź","fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"drawStyle":"bars","fillOpacity":60,"gradientMode":"opacity","lineWidth":2,"showPoints":"never","spanNulls":false,"stacking":{"mode":"normal","group":"A"}},"unit":"short","decimals":0,"min":0},"overrides":[]},"gridPos":{"h":8,"w":12,"x":12,"y":32},"id":109,"interval":"1m","options":{"legend":{"calcs":["sum"],"displayMode":"table","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (result) (round(increase(ai_router_model_attempts_total{result!~\"ok|safety\"}[2m])))","interval":"1m","legendFormat":"{{result}}","refId":"A"}],"title":"Błędy modeli wg przyczyny","type":"timeseries"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Kiedy model był pomijany przez router. Czas trwania zależy od typu błędu (429: 5-300 s lub do końca doby, 5xx: 30 s, 404: 1 h).","fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"drawStyle":"line","fillOpacity":20,"gradientMode":"opacity","lineWidth":2,"showPoints":"never","spanNulls":false,"stacking":{"mode":"none","group":"A"}},"unit":"short","decimals":0,"min":0},"overrides":[]},"gridPos":{"h":8,"w":12,"x":0,"y":40},"id":110,"options":{"legend":{"calcs":[],"displayMode":"table","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"ai_router_model_suspended","legendFormat":"{{model}}","refId":"A"}],"title":"Zawieszenia modeli (1 = cooldown)","type":"timeseries"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Liczba zapytań obsłużonych dzisiaj przez poszczególne modele AI (doba Pacyficzna, bez sztucznego spłaszczania osi Y przez limity 648k).","fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"drawStyle":"line","lineInterpolation":"stepAfter","fillOpacity":20,"gradientMode":"opacity","lineWidth":2,"showPoints":"auto","spanNulls":false,"stacking":{"mode":"none","group":"A"}},"unit":"short","decimals":0,"min":0},"overrides":[]},"gridPos":{"h":8,"w":12,"x":12,"y":40},"id":111,"options":{"legend":{"calcs":["lastNotNull"],"displayMode":"table","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"ai_router_model_requests_today","legendFormat":"{{model}}","refId":"A"}],"title":"Zapytania do API modelu dziś (doba Pacyficzna)","type":"timeseries"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Procentowe zużycie dziennego limitu Free Tier (RPD) per model. Alert przy >80%.","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"unit":"percentunit","min":0,"max":1,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":0.6},{"color":"red","value":0.8}]}},"overrides":[]},"gridPos":{"h":8,"w":8,"x":0,"y":48},"id":112,"options":{"displayMode":"gradient","orientation":"horizontal","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"showUnfilled":true},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (model) (ai_router_model_requests_today) / clamp_min(max by (model) (ai_router_model_daily_limit), 1)","legendFormat":"{{model}}","refId":"A","instant":true}],"title":"Zużycie dziennego limitu wg modelu","type":"bargauge"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"","fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"drawStyle":"line","fillOpacity":20,"gradientMode":"opacity","lineWidth":2,"showPoints":"never","spanNulls":false,"stacking":{"mode":"none","group":"A"}},"unit":"s"},"overrides":[]},"gridPos":{"h":8,"w":8,"x":8,"y":48},"id":113,"options":{"legend":{"calcs":[],"displayMode":"table","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"increase(ai_router_model_ok_latency_seconds_sum[10m]) / clamp_min(increase(ai_router_model_ok_latency_seconds_count[10m]), 1)","legendFormat":"{{model}}","refId":"A"}],"title":"Czas odpowiedzi modelu (śr., 10 min)","type":"timeseries"},
    {"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Udział odpowiedzi z błyskawicznego Cache RAG (<5 ms, 0 tokenów) oraz poszczególnych modeli kaskady AI.","fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"unit":"short","decimals":0},"overrides":[]},"gridPos":{"h":8,"w":8,"x":16,"y":48},"id":114,"options":{"legend":{"displayMode":"table","placement":"right","showLegend":true,"values":["value","percent"],"sortBy":"Value","sortDesc":true},"pieType":"donut","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(ai_router_cache_hits_total) > 0","legendFormat":"Cache RAG (<5ms)","refId":"A","instant":true},{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (source) (ai_router_answers_by_depth_total{source!=\"\"}) > 0","legendFormat":"{{source}}","refId":"B","instant":true}],"title":"Skąd pochodzą odpowiedzi (Cache + AI)","type":"piechart"},
