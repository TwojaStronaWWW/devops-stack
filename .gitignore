# Security & Secrets (ISO 27001 compliance)
.env
.env.local
.env.*.local
scripts/*.env
scripts/*-created.json
*.pem
*.key
*.crt
*.pfx
*.pub
id_ed25519*
id_rsa*
*.password
config/prometheus/*password*
node_modules/

# Cloudflare / Tunnel credentials
cert.pem
!config/grafana/provisioning/**/*.json
!package*.json

# Database dumps, archives & local backups
*.sql
*.dump
*.tar
*.tar.gz
*.tgz
*.zip
*.bak
backups/
dist/

# Runtime data & Docker volumes persisted locally
/data/
/volumes/
logs/
*.log
*.prom
services/ai-router/storage/rate_limits/*.json
!services/ai-router/storage/rate_limits/.gitkeep
services/ai-router/storage/metrics/

# OS & Editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
